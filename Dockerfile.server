# ─────────────────────────────────────────────────────────────────────────────
# Dockerfile.server – PC/Laptop AI server (split-inference architecture)
#
# This image runs the HEAVY AI on the PC:
#   • V-JEPA 2 world model (predictive future-scene embedding)
#   • SSv2-style temporal motion pattern recogniser
#   • Decision fusion  (weighted risk → FORWARD / SLOW / STOP / REROUTE)
#   • OpenCV HUD overlay + TCP servers for UI viewer and robot connection
#
# NOTE: YOLOv8n is NOT loaded in live/tcp mode – the Pi runs it locally and
#       sends CMD_DETECTION.  YOLOv8 is only used in demo mode (no robot).
#
# UI viewer ports: 5003 (cmd) / 8003 (video)
# Robot ports:     5004 (cmd) / 8004 (video)
#
# GPU build (NVIDIA):
#   docker build -f Dockerfile.server -t nav-server .
#   docker run --gpus all \
#     -p 5003:5003 -p 8003:8003 -p 5004:5004 -p 8004:8004 \
#     -v $(pwd)/assets:/app/assets:ro \
#     -v $(pwd)/logs_rpi:/app/logs_rpi \
#     nav-server
#
# CPU-only / demo mode:
#   docker run -p 5003:5003 -p 8003:8003 -p 5004:5004 -p 8004:8004 \
#     -v $(pwd)/assets:/app/assets:ro \
#     nav-server python main_server.py --mode demo --nav predictive --no-display
# ─────────────────────────────────────────────────────────────────────────────

FROM pytorch/pytorch:2.1.2-cuda12.1-cudnn8-runtime

# System dependencies for OpenCV headless + PyQt5
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    python3-pyqt5 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy server code, config, and demo assets
COPY Code/Server/ ./Code/Server/
COPY requirements_server.txt .
COPY assets/ ./assets/

# Install Python dependencies (V-JEPA 2 weights download on first run)
RUN pip install --no-cache-dir -r requirements_server.txt

WORKDIR /app/Code/Server

# UI viewer ports and robot connection ports
EXPOSE 5003 8003 5004 8004

# Default: demo mode with predictive navigation, no display window
CMD ["python", "main_server.py", "--mode", "demo", "--nav", "predictive", "--no-display"]
