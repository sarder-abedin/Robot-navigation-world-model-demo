# ─────────────────────────────────────────────────────────────────────────────
# Dockerfile.server – PC/Laptop AI server (split-inference architecture)
#
# This image runs the HEAVY AI on the PC/laptop:
#   • V-JEPA 2 world model (predictive future-scene embedding)
#   • SSv2-style temporal motion pattern recogniser
#   • Decision fusion  (weighted risk → FORWARD / SLOW / STOP / REROUTE)
#   • OpenCV HUD overlay + TCP servers for UI viewer and robot connection
#
# In LIVE mode YOLOv8n is NOT loaded here — the Pi runs it and sends
# CMD_DETECTION.  YOLOv8 is only used in DEMO mode (no robot connected).
#
# ── Platform support ──────────────────────────────────────────────────────────
# This Dockerfile uses python:3.11-slim and installs CPU-only PyTorch, so it
# builds and runs natively on:
#   • Mac Apple Silicon (arm64/M1/M2/M3)  ← recommended for Mac users
#   • Linux amd64 (CPU-only)
#   • Linux arm64
#
# For NVIDIA GPU acceleration on Linux, replace the base image and use the
# GPU variant of torch:
#   docker build --build-arg USE_GPU=1 -f Dockerfile.server -t nav-server .
# (see GPU variant comment at the RUN pip install step below)
#
# ── Quick start ───────────────────────────────────────────────────────────────
# Build:
#   docker build -f Dockerfile.server -t nav-server .
#
# Demo mode (no robot, no display):
#   docker run --rm \
#     -p 5003:5003 -p 8003:8003 -p 5004:5004 -p 8004:8004 \
#     -v $(pwd)/assets:/app/assets:ro \
#     -v $(pwd)/logs_rpi:/app/logs_rpi \
#     nav-server
#
# Live mode (wait for Pi to connect):
#   docker run --rm \
#     -p 5003:5003 -p 8003:8003 -p 5004:5004 -p 8004:8004 \
#     nav-server python main_server.py --mode live --nav predictive --no-display
#
# Operator UI viewer – run NATIVELY on Mac (recommended) or via X11 on Linux:
#   Mac:   cd Code/Client && pip install PyQt5 opencv-python numpy && python ai_viewer.py
#          (enter 'localhost' as server IP – Docker Desktop maps ports to host)
#   Linux: xhost +local:docker
#          docker run --rm -e DISPLAY=$DISPLAY -v /tmp/.X11-unix:/tmp/.X11-unix \
#            nav-server python Code/Client/ai_viewer.py
#
# Via docker compose:
#   docker compose -f docker-compose.server.yml up
# ─────────────────────────────────────────────────────────────────────────────

FROM python:3.11-slim

# libgomp1:        OpenMP runtime for PyTorch.
# libqt5widgets5 / libqt5gui5 / libqt5core5a: Qt5 runtime for PyQt5 (ai_viewer.py).
# libxcb-xinerama0: xcb platform plugin needed by Qt5 on Linux.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    libqt5widgets5 \
    libqt5gui5 \
    libqt5core5a \
    libxcb-xinerama0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy server code, viewer, config, and demo assets
COPY Code/Server/ ./Code/Server/
COPY Code/Client/ ./Code/Client/
COPY requirements_server.txt .
COPY assets/ ./assets/

# Install Python dependencies.
# pip resolves the correct torch wheel automatically for the build platform:
#   arm64 (Mac M-series) → torch CPU/MPS wheels from PyPI
#   amd64 Linux CPU      → torch CPU wheels from PyPI
#
# For NVIDIA GPU on Linux, build with:
#   docker build --build-arg TORCH_INDEX=https://download.pytorch.org/whl/cu121 \
#                -f Dockerfile.server -t nav-server-gpu .
#
# opencv-python-headless is force-reinstalled so the AI pipeline never needs
# libGL/X11 (server always runs --no-display).
#
# PyQt5 note: pre-built wheels exist for amd64 Linux only.
#   • amd64 Linux → installs fine; viewer can run inside container via X11 forward.
#   • arm64 Linux (Mac M-series Docker) → no wheel; build skips it gracefully.
#     On Mac, run ai_viewer.py NATIVELY and connect to localhost:5003/8003.
ARG TORCH_INDEX=""
RUN grep -v '^PyQt5' requirements_server.txt > /tmp/req_no_qt.txt && \
    if [ -n "$TORCH_INDEX" ]; then \
        pip install --no-cache-dir torch torchvision --index-url "$TORCH_INDEX"; \
    fi && \
    pip install --no-cache-dir -r /tmp/req_no_qt.txt && \
    (pip install --no-cache-dir PyQt5 || echo "PyQt5 skipped – no arm64 wheel; run ai_viewer.py natively") && \
    pip install --no-cache-dir --force-reinstall opencv-python-headless

WORKDIR /app/Code/Server

# UI viewer ports and robot connection ports
EXPOSE 5003 8003 5004 8004

# Default: demo mode with predictive navigation, no display window
CMD ["python", "main_server.py", "--mode", "demo", "--nav", "predictive", "--no-display"]
