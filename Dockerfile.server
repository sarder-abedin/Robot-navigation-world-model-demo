# ─────────────────────────────────────────────────────────────────────────────
# Dockerfile.server – PC/Laptop AI server (split-inference architecture)
#
# This image runs the HEAVY AI on the PC/laptop:
#   • V-JEPA 2 world model (predictive future-scene embedding)
#   • SSv2-style temporal motion pattern recogniser
#   • Decision fusion  (weighted risk → FORWARD / SLOW / STOP / REROUTE)
#   • OpenCV HUD overlay + TCP servers for UI viewer and robot connection
#   • Streamlit browser-based operator UI on port 8501
#
# YOLOv8n also runs here (ALL AI is on the PC). The Pi is a thin client that only
# streams camera frames + ultrasonic, so the server runs detection on those frames
# in every mode. ultralytics is included in requirements_server.txt.
#
# ── Platform support ──────────────────────────────────────────────────────────
# This Dockerfile uses python:3.11-slim and installs CPU-only PyTorch, so it
# builds and runs natively on:
#   • Mac Apple Silicon (arm64/M1/M2/M3)  ← recommended for Mac users
#   • Linux amd64 (CPU-only)
#   • Linux arm64
#
# For NVIDIA GPU acceleration on Linux, replace the base image and use the
# GPU variant of torch:
#   docker build --build-arg USE_GPU=1 -f Dockerfile.server -t nav-server .
# (see GPU variant comment at the RUN pip install step below)
#
# ── Quick start ───────────────────────────────────────────────────────────────
# Build:
#   docker build -f Dockerfile.server -t nav-server .
#
# Demo mode (no robot):
#   docker run --rm \
#     -p 5003:5003 -p 8003:8003 -p 5004:5004 -p 8004:8004 -p 8501:8501 \
#     -v $(pwd)/assets:/app/assets:ro \
#     -v $(pwd)/logs_rpi:/app/logs_rpi \
#     nav-server
#   Then open http://localhost:8501 in your browser.
#
# Live mode (wait for Pi to connect):
#   docker run --rm \
#     -p 5003:5003 -p 8003:8003 -p 5004:5004 -p 8004:8004 -p 8501:8501 \
#     -e NAV_MODE=live \
#     nav-server
#
# Server only (no Streamlit):
#   docker run --rm \
#     -p 5003:5003 -p 8003:8003 -p 5004:5004 -p 8004:8004 \
#     nav-server python main_server.py --mode demo --nav predictive --no-display
#
# Via docker compose:
#   docker compose -f docker-compose.server.yml up
# ─────────────────────────────────────────────────────────────────────────────

FROM python:3.11-slim

# libgomp1:        OpenMP runtime for PyTorch.
# libqt5widgets5 / libqt5gui5 / libqt5core5a: Qt5 runtime for PyQt5 (ai_viewer.py).
# libxcb-xinerama0: xcb platform plugin needed by Qt5 on Linux.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    libqt5widgets5 \
    libqt5gui5 \
    libqt5core5a \
    libxcb-xinerama0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy server code, viewer, config, demo assets, and startup script
COPY Code/Server/ ./Code/Server/
COPY Code/Client/ ./Code/Client/
COPY requirements_server.txt .
COPY assets/ ./assets/
COPY start_server.sh /app/start_server.sh
RUN chmod +x /app/start_server.sh

# Install Python dependencies.
# pip notes:
#   • pip 24.0 (in python:3.11-slim) has a hash-verification bug with CUDA packages.
#     We upgrade pip first to fix it.
#   • torch 2.8+ bundles CUDA as hard pip deps on arm64 Linux (Mac M-series Docker).
#     requirements_server.txt caps at <2.8.0 to keep the image CPU-only by default.
#   • For NVIDIA GPU on Linux, pass TORCH_INDEX to install the CUDA torch separately
#     BEFORE the requirements file is processed, bypassing the cap:
#       docker build --build-arg TORCH_INDEX=https://download.pytorch.org/whl/cu121 \
#                    -f Dockerfile.server -t nav-server-gpu .
#   • opencv-python-headless is force-reinstalled so the AI pipeline never needs
#     libGL/X11 (server always runs --no-display).
#   • PyQt5: pre-built wheels exist for amd64 Linux only.
#     arm64 Linux (Mac M-series Docker) → no wheel; gracefully skipped.
#     Use the Streamlit viewer (http://localhost:8501) on Mac instead.
ARG TORCH_INDEX=""
RUN pip install --upgrade pip && \
    grep -v '^PyQt5' requirements_server.txt > /tmp/req_no_qt.txt && \
    if [ -n "$TORCH_INDEX" ]; then \
        pip install --no-cache-dir torch torchvision --index-url "$TORCH_INDEX"; \
        grep -v '^torch' /tmp/req_no_qt.txt | grep -v '^torchvision' > /tmp/req_no_torch_qt.txt; \
        pip install --no-cache-dir -r /tmp/req_no_torch_qt.txt; \
    else \
        pip install --no-cache-dir -r /tmp/req_no_qt.txt; \
    fi && \
    (pip install --no-cache-dir PyQt5 || echo "PyQt5 skipped – no arm64 wheel; use Streamlit viewer at http://localhost:8501") && \
    pip install --no-cache-dir --force-reinstall opencv-python-headless

WORKDIR /app/Code/Server

# UI viewer ports, robot connection ports, and Streamlit browser UI port
EXPOSE 5003 8003 5004 8004 8501

# Default: start AI server + Streamlit viewer together.
# Open http://localhost:8501 in your browser after container starts.
CMD ["/app/start_server.sh"]
